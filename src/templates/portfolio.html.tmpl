<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>${title}</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 2rem auto; max-width: 1200px; color: #1f2937; }
    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { border: 1px solid #d1d5db; padding: 0.6rem; text-align: left; }
    th { background: #f3f4f6; }
    .meta { color: #4b5563; margin-bottom: 1rem; }
  </style>
</head>
<body>
  <h1>${title}</h1>
  <div class="meta">
    <div><strong>Runs:</strong> ${runs_count}</div>
    <div><strong>Strategies:</strong> ${strategies}</div>
    <div><strong>Benchmarks:</strong> ${benchmarks}</div>
    <div><strong>Best run:</strong> ${best_run_name} (${best_run_score})</div>
    <div><strong>Total certainty conclusions:</strong> ${total_certainty_conclusions}</div>
    <div><strong>High-certainty recommendations:</strong> ${total_high_certainty_recommendations}</div>
    <div><strong>Certainty bands:</strong> ${certainty_counts}</div>
    <div><strong>Best certainty run:</strong> ${best_certainty_run_name} (${best_certainty_run_high})</div>
    <div><strong>Total retries:</strong> ${total_retries}</div>
    <div><strong>Total Tool calls:</strong> ${total_tool_calls}</div>
    <div><strong>Total Tool failures:</strong> ${total_tool_failures}</div>
    <div><strong>Most unstable run:</strong> ${unstable_run_name} (${unstable_run_retries})</div>
  </div>
  <table>
    <thead>
      <tr>
        <th>Run</th>
        <th>Topic</th>
        <th>Benchmark</th>
        <th>Strategy</th>
        <th>Best Score</th>
        <th>Rubric Grade</th>
        <th>Consistency</th>
        <th>Certainty conclusions</th>
        <th>High-certainty conclusions</th>
        <th>High-certainty recommendations</th>
        <th>Certainty Δ vs best</th>
        <th>Total Retries</th>
        <th>Tool calls</th>
        <th>Tool failures</th>
      </tr>
    </thead>
    <tbody>
      ${runs_table_html}
    </tbody>
  </table>
</body>
</html>
